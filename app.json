{
  "expo": {
    "name": "Growmax Admin",
    "slug": "GrowmaxAdmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/secondLogo.png",
    "scheme": "growmaxapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1B5E3F",
      "image": "./assets/images/secondLogo.png",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.growmax.engineers",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/secondLogo.png",
        "backgroundImage": "./assets/images/secondLogo.png",
        "monochromeImage": "./assets/images/secondLogo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.growmax.engineers"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/secondLogo.png"
    },
    "plugins": [
      "expo-web-browser",
      "@logrocket/react-native",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 25
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75f65efb-c203-49c5-ad25-dcc4a3a3f140"
      }
    },
    "owner": "dev_786"
  }
}
